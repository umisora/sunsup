# Public PostHog ingestion settings. Next.js inlines NEXT_PUBLIC_* into the static export at build time.
# Leave both empty to ship with analytics off. Do not put a personal API key here.
# The host for the EU Cloud project is https://eu.i.posthog.com — set that as the variable value, not in code.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
